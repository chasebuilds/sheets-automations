{
  "name": "sheets-automations",
  "version": "0.1.0",
  "description": "Google Apps Script automations for small businesses, written in TypeScript with unit-tested logic.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "samples": "node scripts/make-samples.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
